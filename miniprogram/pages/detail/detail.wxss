.page {
  padding: 28rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  line-height: 1.45;
}

.meta {
  font-size: 24rpx;
  margin: 14rpx 0;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin: 18rpx 0;
}

.tag {
  background: #ecfeff;
  color: #155e75;
  border-radius: 8rpx;
  padding: 5rpx 10rpx;
  font-size: 22rpx;
}

.summary {
  background: #ffffff;
  border: 1rpx solid #e2e8f0;
  border-radius: 12rpx;
  color: #334155;
  font-size: 28rpx;
  line-height: 1.7;
  padding: 24rpx;
}

.copy {
  margin-top: 28rpx;
  background: #0f766e;
  color: #ffffff;
}

.state {
  padding: 72rpx 20rpx;
  text-align: center;
  color: #64748b;
}
